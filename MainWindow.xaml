<Window x:Class="trophy_alert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="奖杯弹窗 · 预览"
        Width="420" Height="222"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#1B1D22"
        FontFamily="Microsoft YaHei UI">

    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="奖杯弹窗"
                   Foreground="White" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="程序启动时不自动弹出，进度文件变化时自动弹。"
                   Foreground="#9A9DA6" FontSize="13" Margin="0,8,0,18" TextWrapping="Wrap" />

        <Button Content="弹最新解锁的成就"
                Width="220" Height="34"
                HorizontalAlignment="Left"
                Click="OnReadProgressClick" />
    </StackPanel>
</Window>
